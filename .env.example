# Copy to .env and fill in locally. Never commit real values.

# Model provider: auto | offline | anthropic | gemini
OKNO_PROVIDER=auto
# Optional model override, e.g. claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, gemini-2.5-flash-lite
OKNO_MODEL=

# Claude (official SDK reads this variable)
ANTHROPIC_API_KEY=
# Gemini (OpenAI-compatible endpoint, Bearer auth)
GEMINI_API_KEY=

# Lead delivery
OKNO_LEADS_FILE=data/leads.jsonl
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OKNO_WEBHOOK_URL=

# CRM (optional)
BITRIX24_WEBHOOK_URL=
AMOCRM_BASE_URL=
AMOCRM_TOKEN=

# Customer channels (see docs/channels.md)
TELEGRAM_CUSTOMER_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Owner panel and knowledge base
OKNO_ADMIN_TOKEN=
OKNO_KB_PATH=data/company.json
